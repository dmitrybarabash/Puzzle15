<Window x:Class="Puzzle15.Wpf.Mvvm.Views.BestScoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Puzzle15.Wpf.Mvvm.Views"
        xmlns:localviewmodels="clr-namespace:Puzzle15.Wpf.Mvvm.ViewModels"
        mc:Ignorable="d"
        Icon="/Images/Puzzle15.ico"
        Title="Лучшие результаты"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">

    <!-- Создаем ViewModel и соединяем его с нашим View -->
    <!-- В данном случае из соображений low coupling я предпочел сделать это не здесь, а при
         создании экземпляра этого окна, но пример как это делается в XAML'е закомментировал и оставил.
         Так XAML умеет создать объект только конструктором без параметров, а BestScoresViewModel
         получает модель через конструктор. Поэтому пример сейчас не заработает, и это еще одна причина
         создавать ViewModel в коде.
    <Window.DataContext>
        <localviewmodels:BestScoresViewModel/>
    </Window.DataContext>
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0" Header="Лучшие результаты:" Margin="20,15,20,0" BorderBrush="Gainsboro" BorderThickness="1">
            <!-- Каждая строка — отдельный Grid, а SharedSizeGroup выравнивает ширину столбцов во всех строках -->
            <!-- ItemsControl — тоже Control, и без Focusable="False" Tab останавливался бы на нем самом -->
            <ItemsControl Margin="10" Focusable="False" Grid.IsSharedSizeScope="True"
                          ItemsSource="{Binding Path=Rows, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <!-- Строки не меняются, пока окно открыто, поэтому их свойства привязаны в режиме OneTime -->
                    <DataTemplate DataType="{x:Type localviewmodels:BestScoreRowViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Place"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Moves"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Timer"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Margin" Value="20,5,20,5"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </Grid.Resources>

                            <TextBlock Grid.Column="0" Text="{Binding Path=Place, Mode=OneTime, StringFormat={}{0}.}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Path=Name, Mode=OneTime}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Path=Moves, Mode=OneTime}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Path=Timer, Mode=OneTime}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>
        <Button Grid.Row="1" Content="OK" HorizontalAlignment="Center" Margin="0,15" Padding="40,5" IsDefault="True" IsCancel="True"/>
    </Grid>
</Window>
