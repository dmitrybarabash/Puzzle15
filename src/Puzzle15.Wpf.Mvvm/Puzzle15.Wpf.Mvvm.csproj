    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <AssemblyTitle>Puzzle 15 (WPF, MVVM)</AssemblyTitle>
    <ApplicationIcon>..\..\assets\Puzzle15.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Puzzle15.Common\Puzzle15.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Images\MenuItemAbout.png" />
