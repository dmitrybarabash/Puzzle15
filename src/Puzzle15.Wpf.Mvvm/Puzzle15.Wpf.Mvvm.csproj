    <None Remove="Images\MenuItemExit.png" />
    <None Remove="Images\MenuItemNewGame.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\Puzzle15.ico" Link="Images\Puzzle15.ico" />
